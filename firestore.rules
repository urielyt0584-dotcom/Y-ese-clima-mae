rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 60 &&
             data.sanPedroBlamesCount is int &&
             data.sanPedroBlamesCount >= 0 &&
             (!('favoriteCantons' in data) || (data.favoriteCantons is list && data.favoriteCantons.size() <= 30)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCommunityBlame(data) {
      return data.id is string &&
             data.userUid is string &&
             data.userUid == request.auth.uid &&
             data.userName is string &&
             data.userName.size() >= 1 &&
             data.userName.size() <= 60 &&
             data.canton is string &&
             data.canton.size() >= 1 &&
             data.canton.size() <= 100 &&
             data.comment is string &&
             data.comment.size() >= 1 &&
             data.comment.size() <= 300 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /community_blames/{blameId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidCommunityBlame(request.resource.data);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.userUid == request.auth.uid;
    }

    // Insultos y frases de temporada:
    // Lectura pública para que cualquier usuario (incluso sin iniciar sesión) reciba los dichos actualizados.
    // Escritura 100% bloqueada desde clientes: solo administradores desde la consola de Firebase pueden crear/modificar insultos.
    match /seasonal_insults/{insultId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
