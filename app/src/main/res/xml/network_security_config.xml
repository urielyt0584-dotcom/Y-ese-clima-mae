<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deshabilita por completo el tráfico HTTP sin cifrar (Cleartext) en toda la aplicación -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
